generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Explanation {
  id          String    @id @default(cuid())
  topic       String
  content     String
  description String?   // AI-generated witty description of the terrible explanation
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  upvotes     Int       @default(0)
  downvotes   Int       @default(0)
  helpful     Int       @default(0)
  notHelpful  Int       @default(0)
  votes       VoteLog[]
}

// Track submissions for rate limiting (per IP, per day)
model SubmissionLog {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// Track votes for rate limiting and preventing duplicate votes
model VoteLog {
  id            String      @id @default(cuid())
  ip            String
  explanationId String
  voteType      String      // "upvote" or "downvote"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  explanation   Explanation @relation(fields: [explanationId], references: [id], onDelete: Cascade)

  @@unique([ip, explanationId])
  @@index([ip, createdAt])
}
